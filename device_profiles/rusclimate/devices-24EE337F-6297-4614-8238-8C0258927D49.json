  "messages": {
    "diag": {
      "en-US": "To erase network settings please press simultaneously buttons Mode (2) and Time (3) and hold for 10 seconds.",
      "ru-RU": "Чтобы сбросить настройки сети одновременно нажмите кнопки Режима (2) и Времени (3) на 10 секунд."
    },
    "pair": {
      "en-US": "To activate the pairing mode, press and hold the \"Power\" and \"Time\" buttons simultaneously on the device for 3 seconds. The message \"Conn\" will appear on the water heater display.",
      "ru-RU": "Для активации режима сопряжения одновременно нажмите и удерживайте кнопки «Мощность» и «Время» на устройстве в течение 3 секунд. На экране водонагревателя появится надпись «Conn»."
    },
    "reset": {
      "en-US": "To reset the settings, press and hold the \"Power\" and \"Time\" buttons simultaneously on the device for 10 seconds.",
      "ru-RU": "Чтобы сбросить настройки одновременно нажмите и удерживайте кнопки «Мощность» и «Время» на устройстве в течение 10 секунд."
    },

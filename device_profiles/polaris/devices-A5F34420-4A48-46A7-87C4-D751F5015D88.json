  "messages": {
    "howto": {
      "ar-AE": "نصائح",
      "de-DE": "Beratung",
      "en-US": "Advices",
      "kk-KZ": "Кеңестер",
      "ru-RU": "Обучение",
      "uk-UA": "Рада"
    },
    "enable": {
      "ar-AE": "للاتصال \"فتح كل من الأسلحة معبد من النظارات وانتظر\" الاقتران \" إشارة الصوت",
      "de-DE": "Öffnen Sie zum Verbinden beide Bügelarme der Brille und warten Sie auf das Tonsignal \"Pairing\"",
      "en-US": "For connection, open both temple arms of the glasses and wait for the “Pairing” sound signal",
      "kk-KZ": "Қосылу үшін екі көзілдірікті де ашып, \"Сопряжение\"дыбыстық сигналын күтіңіз",
      "ru-RU": "Для подключения откройте обе дужки очков и дождитесь звукового сигнала \"Сопряжение\"",
      "uk-UA": "For connection, open both temple arms of the glasses and wait for the “Pairing” sound signal"
    },
    "dialogs": {
      "ar-AE": "تسجيل الاجتماع",
      "de-DE": "Protokoll der Sitzung",
      "en-US": "Meeting recording",
      "kk-KZ": "Жиналыс жазбасы",
      "ru-RU": "Запись встреч",
      "uk-UA": "Запис зборів"
    },
    "assistant": {
      "ar-AE": "مساعد صوت",
      "de-DE": "Sprachassistent",
      "en-US": "Voice Assistant",
      "kk-KZ": "Дауыстық Көмекші",
      "ru-RU": "Голосовой ассистент",
      "uk-UA": "Голосовий асистент"
    },
    "translate": {
      "ar-AE": "مترجم",
      "de-DE": "Übersetzer",
      "en-US": "Translator",
      "kk-KZ": "Аудармашы",
      "ru-RU": "Переводчик",
      "uk-UA": "Перекладач"
    },
    "enable_ios": {
      "ar-AE": "للاتصال ، افتح ذراعي المعبد للنظارات وانتظر إشارة الصوت\" الاقتران\". افتح إعدادات البلوتوث وقم بتوصيل الجهاز الإضافي\" سغ-01 \" في قسم الأجهزة الأخرى. بعد إشارة الصوت\" المتصلة \" ، ارجع إلى التطبيق للمتابعة.",
      "de-DE": "Öffnen Sie zum Verbinden beide Bügelarme der Brille und warten Sie auf das Tonsignal \"Pairing\". Öffnen Sie die Bluetooth-Einstellungen und verbinden Sie das Zusatzgerät \"SG-01\" im Bereich Andere Geräte. Kehren Sie nach dem Tonsignal \"Verbunden\" zur App zurück, um fortzufahren.",
      "en-US": "For connection, open both temple arms of the glasses and wait for the “Pairing” sound signal. Open the Bluetooth settings and connect the additional device “SG-01” in the Other Devices section. After the “Connected” sound signal, return to the app to continue.",
      "kk-KZ": "Қосылу үшін екі көзілдірікті де ашып, \"Сопряжение\"дыбыстық сигналын күтіңіз. Bluetooth параметрлерін ашып, \"SG-01\" қосымша құрылғысын басқа құрылғылар бөлімінде қосыңыз. \"Соединено\" дыбыстық сигналдан кейін жалғастыру үшін қолданбаға оралыңыз",
      "ru-RU": "Для подключения откройте обе дужки очков и дождитесь звукового сигнала \"Сопряжение\". Откройте настройки Bluetooth и подключите дополнительное устройство \"SG-01\" в разделе Другие устройства. После звукового сигнала \"Соединено\" вернитесь в приложение, чтобы продолжить",
      "uk-UA": "For connection, open both temple arms of the glasses and wait for the “Pairing” sound signal. Open the Bluetooth settings and connect the additional device “SG-01” in the Other Devices section. After the “Connected” sound signal, return to the app to continue."
    },
    "unpair_ios": {
      "ar-AE": "هل تريد فصل هذا الجهاز عن هاتفك?\nلا تنس إلغاء الاقتران في إعدادات البلوتوث بالهاتف",
      "de-DE": "Möchten Sie dieses Gerät von Ihrem Telefon trennen?\nVergessen Sie nicht, die Kopplung in den Bluetooth-Einstellungen des Telefons abzubrechen",
      "en-US": "Do you want to disconnect this device from your phone?\nDon’t forget to cancel the pairing in the phone’s Bluetooth settings",
      "kk-KZ": "Бұл құрылғыны телефоннан ажыратқыңыз келе ме?\nТелефонның Bluetooth параметрлерінде жұптастырудан бас тартуды ұмытпаңыз",
      "ru-RU": "Вы хотите отключить это устройство от своего телефона?\nНе забудьте отменить сопряжение в Bluetooth настройках телефона"
    },

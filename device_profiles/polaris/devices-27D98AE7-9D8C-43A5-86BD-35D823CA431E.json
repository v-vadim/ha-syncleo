  "messages": {
    "diag": {
      "ar-AE": "اضغط مع الاستمرار على الأزرار \"+\" و \"-\" في نفس الوقت حتى سماع صفير واحد. انتظر 10 ثوانٍ. سيبدأ مؤشر الواي فاي في الوميض.",
      "de-DE": "Drücken Sie gleichzeitig die Tasten \"+\" und \"-\" bis zu einem Piepton. Warten Sie 10 Sekunden. Die Wi-Fi-Anzeige beginnt zu blinken.",
      "en-US": "Press and hold the \"+\" and \"-\" buttons simultaneously until 1 beep. Wait for 10 seconds. The Wi-Fi indicator will start blinking.",
      "kk-KZ": "\"+\" және \"-\" батырмаларын бір уақытта 1 дыбыстық сигналға дейін басып тұрыңыз. 10 секунд күтіңіз. Wi-Fi индикаторы мигауға бастайды.",
      "ru-RU": "Зажмите и удерживайте одновременно кнопки \"+\" и \"-\" до 1 звукового сигнала. Подождите 10 секунд. Индикатор Wi-Fi начнет мигать.",
      "uk-UA": "Одночасно утримуйте кнопки \"+\" та \"-\" до 1 звукового сигналу. Почекайте 10 секунд. Індикатор Wi-Fi почне блимати."
    },
    "pair": {
      "ar-AE": "اضغط مع الاستمرار على الأزرار \"+\" و \"-\" في نفس الوقت حتى سماع صفير واحد. تأكيدًا، سيبدأ مؤشر الواي فاي في الوميض.",
      "de-DE": "Drücken Sie gleichzeitig die Tasten \"+\" und \"-\" bis zu einem Piepton. Zur Bestätigung beginnt die Wi-Fi-Anzeige zu blinken.",
      "en-US": "Press and hold the \"+\" and \"-\" buttons simultaneously until 1 beep. The Wi-Fi indicator will start blinking as confirmation.",
      "kk-KZ": "\"+\" және \"-\" батырмаларын бір уақытта 1 дыбыстық сигналға дейін басып тұрыңыз. Растау үшін Wi-Fi индикаторы мигауға бастайды.",
      "ru-RU": "Зажмите и удерживайте одновременно кнопки \"+\" и \"-\" до 1 звукового сигнала. В подтверждение индикатор Wi-Fi начнет мигать.",
      "uk-UA": "Одночасно утримуйте кнопки \"+\" та \"-\" до 1 звукового сигналу. Для підтвердження індикатор Wi-Fi почне блимати."
    },
    "zero": {
      "en-US": "Off"
    },
    "reset": {
      "ar-AE": "اضغط مع الاستمرار على الأزرار \"+\" و \"-\" في نفس الوقت حتى سماع ثلاث صفير. سيطفأ مؤشر الواي فاي.",
      "de-DE": "Drücken Sie gleichzeitig die Tasten \"+\" und \"-\" bis zu drei Pieptönen. Die Wi-Fi-Anzeige wird ausgeschaltet.",
      "en-US": "Press and hold the \"+\" and \"-\" buttons simultaneously until 3 beeps. The Wi-Fi indicator will turn off.",
      "kk-KZ": "\"+\" және \"-\" батырмаларын бір уақытта 3 дыбыстық сигналға дейін басып тұрыңыз. Wi-Fi индикаторы сөнеді.",
      "ru-RU": "Зажмите и удерживайте одновременно кнопки \"+\" и \"-\" до 3 звуковых сигналов. Индикатор Wi-Fi погаснет.",
      "uk-UA": "Одночасно утримуйте кнопки \"+\" та \"-\" до 3 звукових сигналів. Індикатор Wi-Fi вимкнеться."
    },
